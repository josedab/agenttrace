# Copy to deploy/.env and replace every value marked "change-me".

# Application images
VERSION=0.1.0
REDIS_IMAGE=cgr.dev/chainguard/redis@sha256:6ec869af943bab77848981ab9469f5b7eef97d166c7ee4ebb4f1b006622d54fa
NGINX_IMAGE=cgr.dev/chainguard/nginx@sha256:4a7323c4539d04a2d515f7b5f5f449b0d70d06e8128558585c2cabcc05ad2a76

# Database credentials
POSTGRES_USER=agenttrace
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=agenttrace
POSTGRES_SSL_MODE=disable
POSTGRES_ALLOW_INSECURE=true

CLICKHOUSE_USER=agenttrace
CLICKHOUSE_PASSWORD=change-me-clickhouse
CLICKHOUSE_DB=agenttrace

REDIS_PASSWORD=change-me-redis

# Optional external S3-compatible object storage for exports
MINIO_ENABLED=false
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=true
MINIO_BUCKET=agenttrace-exports

# Authentication and browser security
JWT_SECRET=change-me-jwt
JWT_ACCESS_EXPIRY_MINUTES=1440
JWT_REFRESH_EXPIRY_DAYS=7
JWT_ISSUER=agenttrace
SERVER_CSRF_ENABLED=true
SERVER_SECURE_COOKIES=true

# Public URLs. NEXT_PUBLIC_API_URL is embedded when the web image is built.
NEXTAUTH_URL=https://agenttrace.example.com
NEXTAUTH_SECRET=change-me-nextauth
AUTH_TRUST_HOST=true
NEXT_PUBLIC_API_URL=https://agenttrace.example.com
PUBLIC_URL=https://agenttrace.example.com
CORS_ALLOWED_ORIGINS=https://agenttrace.example.com
CORS_ALLOW_CREDENTIALS=true

# Local/private mode. Enabling no-egress requires external providers below to remain disabled.
PRIVACY_NO_EGRESS=false
PRIVACY_REDACTION_ENABLED=true

# OAuth providers
OAUTH_CALLBACK_SECRET=change-me-oauth-callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional GitHub outcome reporting
GITHUB_REPORTING_ENABLED=false
GITHUB_API_URL=https://api.github.com
GITHUB_REPORT_TOKEN=

# Optional integrations
OPENAI_API_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.1

# Ports
API_PORT=8080
WEB_PORT=3000
HTTP_PORT=80
OTEL_RECEIVER_ENABLED=false
OTEL_RECEIVER_GRPC_PORT=4317

# Runtime tuning
LOG_LEVEL=info
RATE_LIMIT_REQUESTS_PER_SECOND=100
RATE_LIMIT_BURST=200
RATE_LIMIT_USER_MAX_PER_MINUTE=100
