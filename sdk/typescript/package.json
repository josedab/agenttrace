{
  "name": "agenttrace",
  "version": "0.1.0",
  "description": "TypeScript SDK for AgentTrace - Observability for AI Coding Agents",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "llm",
    "observability",
    "tracing",
    "ai",
    "agents",
    "langfuse",
    "agenttrace"
  ],
  "author": "AgentTrace <team@agenttrace.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agenttrace/agenttrace"
  },
  "homepage": "https://agenttrace.io",
  "bugs": {
    "url": "https://github.com/agenttrace/agenttrace/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "globals": "17.7.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "peerDependencies": {
    "anthropic": ">=0.18.0",
    "openai": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "anthropic": {
      "optional": true
    }
  }
}
